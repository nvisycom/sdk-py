# Environment variables for Nvisy Python SDK development
# Copy this file to .env and fill in your actual values

# API Configuration
NVISY_API_BASE_URL=https://api.nvisy.com
NVISY_API_KEY=your_api_key_here
NVISY_API_SECRET=your_api_secret_here

# OpenAPI Configuration
OPENAPI_ENDPOINT=https://api.nvisy.com/openapi.yaml
OPENAPI_OUTPUT_DIR=openapi
OPENAPI_FILENAME=nvisy-api.yaml
GENERATED_CODE_DIR=src/nvisy/generated

# Development Configuration
PYTHON_VERSION=3.11
LOG_LEVEL=INFO
DEBUG=false

# Testing Configuration
TEST_API_BASE_URL=https://api-staging.nvisy.com
TEST_API_KEY=your_test_api_key_here
RUN_INTEGRATION_TESTS=false

# PyPI Configuration (for publishing)
PYPI_USERNAME=__token__
PYPI_PASSWORD=your_pypi_token_here
TEST_PYPI_USERNAME=__token__
TEST_PYPI_PASSWORD=your_test_pypi_token_here

# Documentation
DOCS_URL=https://sdk-py.nvisy.com
REPO_URL=https://github.com/nvisy/sdk-py

# CI/CD Configuration
CI=false
GITHUB_TOKEN=your_github_token_here

# Security
BANDIT_SKIP_TESTS=B101,B601
SAFETY_IGNORE_IDS=12345,67890
